      "predictiveBackGestureEnabled": false,
      "package": "com.jaem.JUP_movil_rn"
    },
    "web": {
      "favicon": "./assets/iconjup.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite el acceso con reconocimiento facial para iniciar sesion mas rapido."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ab009fbc-4b12-432f-a98b-9ac2181f0b4e"
      }
    }
  }
